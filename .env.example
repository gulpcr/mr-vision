# ============================================
# MRI AI Platform - Environment Configuration
# ============================================
# Copy this file to .env and replace all placeholder values.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mri_platform
POSTGRES_USER=mri_admin
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
# Tenant isolation via Postgres Row-Level Security (migration 044). POSTGRES_USER owns
# the schema and runs migrations; Postgres exempts owners/superusers from RLS, so the
# app must connect as this separate NOSUPERUSER/NOBYPASSRLS role for isolation to be
# DB-enforced. Set both BEFORE the backend starts: migration 044 creates the role (or
# resets its password) from these values. Leave empty to keep connecting as
# POSTGRES_USER (policies inert; application-level tenant filters only).
POSTGRES_APP_USER=mrv_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_SECURE_APP_PASSWORD
# Refuse to start unless the DB role is actually subject to RLS. Enable in production.
REQUIRE_RLS=false

# ── Shared-PACS tenant attribution (Phase 2) ─────────────────────────────────
# Secret the Orthanc stable-study webhook must present (passed to Orthanc by compose).
ORTHANC_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET
# Tenant for C-STORE studies sent to an AE title not assigned to any tenant
# (POST /api/admin/tenants/{id}/dicom-endpoints). "default" = Admin tenant (single-
# tenant installs). Set empty in multi-tenant production: unmapped studies are then
# left unattributed (Orthanc label "unattributed", platform-admin visible only).
DICOM_UNMAPPED_AET_TENANT=default
# Viewer-session cookie (OHIF/DICOMweb/WebSocket auth). true once served over HTTPS.
VIEWER_COOKIE_SECURE=false

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mri_minio_admin
MINIO_SECRET_KEY=REPLACE_WITH_SECURE_PASSWORD
MINIO_BUCKET=mri-artifacts
MINIO_SECURE=false

# --- Orthanc ---
ORTHANC_HOST=orthanc
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
# base64 of "ORTHANC_USERNAME:ORTHANC_PASSWORD" — nginx sends it to Orthanc for the viewer.
#   python -c "import base64;print(base64.b64encode(b'user:pass').decode())"
ORTHANC_BASIC_AUTH=REPLACE_WITH_BASE64
# Scanners allowed to send DICOM to port 4242 (JSON, Orthanc DicomModalities format).
ORTHANC_DICOM_MODALITIES={}

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
API_KEY=REPLACE_WITH_SECURE_API_KEY

# --- Multi-tenancy & security hardening ---
# MULTI_TENANT_ENABLED turns on subdomain / workspace resolution, suspended-tenant
# blocking on every request, and per-tenant plan/feature entitlements (which AI use
# cases a tenant may run — including auto-routed jobs). Tenant data isolation itself
# (Row-Level Security + scoped repositories) is always on, independent of this flag.
# Before enabling: give each tenant's plan its use-case features (/admin/plans) —
# a tenant without a feature cannot run that use case.
MULTI_TENANT_ENABLED=false
# Anonymous self-registration into the Admin workspace. Keep false: workspace admins
# invite their users (Users → Invite user), which sets the right workspace and role.
PUBLIC_REGISTRATION_ENABLED=false
# How long invitation / password-reset links stay valid (hours).
INVITATION_TTL_HOURS=3
# Subdomain a request's Host header is matched against to resolve a tenant slug
# (e.g. "acme.mr-vision.ai" -> slug "acme"). Only consulted when MULTI_TENANT_ENABLED
# is true; header (X-Tenant-Slug) / query-param (?slug=) resolution works regardless.
TENANT_ROOT_DOMAIN=mr-vision.ai
# MFA (TOTP) lockout — shared chokepoint for the login-time verify step and the
# /mfa/disable step.
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15
# Self-authenticated DICOM upload via a tenant API key (POST /api/dicom/upload).
DICOM_UPLOAD_RATE_LIMIT_PER_MINUTE=60

# --- CORS ---
# Comma-separated list of allowed origins, or * for all (dev only)
ALLOWED_ORIGINS=http://103.93.216.37,http://103.93.216.37:3000,http://103.93.216.37:80

# --- Celery ---
CELERY_BROKER_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/1
CELERY_WORKER_CONCURRENCY=2

# --- GPU ---
# CUDA_VISIBLE_DEVICES is no longer set here — the worker container's
# entrypoint (backend/docker/select-healthy-gpu.sh) real-compute-tests every
# GPU on the host at startup and sets it dynamically to whichever pass.
ENABLE_GPU=true

# --- Site ---
SITE_ID=default

# --- Routing / auto-classification ---
# When true, a use-case rule that declares region conditions (body parts / study
# or series description patterns) only matches a study that positively matches at
# least one of them — modality is necessary but not sufficient. Prevents an MR
# study with sparse DICOM tags from routing to every MR use case. Set false for
# legacy OR-matching (modality OR any region condition).
ROUTING_REQUIRE_REGION_MATCH=true

# --- Patient identity on screen ---
# false (default): show the MRN instead of the patient's name everywhere a person sees
# it (UI, PDF reports, OHIF viewer). Stored data and PACS/FHIR exports keep the name.
DISPLAY_PATIENT_NAMES=false

# --- Viewer: hide non-diagnostic series ---
# When true, the OHIF series list is filtered (via the QIDO /series response) to
# drop localizer / shim / calibration / field-map / scout series that render as
# noise. Pixels/WADO are untouched. Set false to show every series.
VIEWER_HIDE_NONDIAGNOSTIC_SERIES=true

# Link CT-report "Flagged Slices" tiles to their exact DICOM image: clicking a tile jumps
# the embedded viewer to it (with the tile's W/L) and flagged images get a red highlight
# while scrolling. Set false to disable the /flagged-slices endpoint and the links.
FLAGGED_SLICE_VIEWER_LINK_ENABLED=true

# --- LLM Report Generation (Phase 1) ---
# Set LLM_ENABLED=true and supply a Gemini API key to add AI narrative impressions to PDF reports.
# Get a key at https://aistudio.google.com/
LLM_ENABLED=false
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
# Which Gemini endpoint every LLM/VLM feature uses:
#   api_key — Google AI Studio with GEMINI_API_KEY above (local/dev). AI Studio is NOT
#             covered by the Google Cloud BAA: never send PHI through it in production.
#   vertex  — Vertex AI in GCP_PROJECT / GCP_LOCATION, authenticated by Application
#             Default Credentials (on GCE: the VM's service account, which needs
#             roles/aiplatform.user). No key needed; GEMINI_API_KEY is ignored.
# The "Requires GEMINI_API_KEY" notes below mean "requires a configured backend":
# a key for api_key, GCP_PROJECT for vertex.
GEMINI_BACKEND=api_key
GCP_PROJECT=
GCP_LOCATION=us-central1

# --- VLM Image Quality Assessment (Phase 2) ---
# Set VLM_QA_ENABLED=true to run Gemini Vision QA on rendered MRI slices before inference.
# Requires GEMINI_API_KEY above. VLM_QA_MAX_SERIES caps API calls per study.
VLM_QA_ENABLED=false
VLM_QA_MAX_SERIES=3

# --- LLM Clinical Decision Support (Phase 3) ---
# Set CDS_ENABLED=true to generate risk-stratified clinical context after each inference.
# Output is stored in Result.summary["clinical_context"] and rendered in PDF reports.
# Requires GEMINI_API_KEY above. All CDS output carries a mandatory radiologist review disclaimer.
CDS_ENABLED=false

# --- LLM Longitudinal Trend Analysis (Phase 4) ---
# Set LONGITUDINAL_ENABLED=true to compare the current study against prior results for the same
# patient. Generates trend assessment (progression/regression/stable), response categories
# (RANO 2.0, PERCIST 1.0, etc.), and key metric changes across timepoints.
# Stored in Result.summary["longitudinal_analysis"] and rendered as a PDF section.
# Requires GEMINI_API_KEY above and at least one prior result for the patient.
LONGITUDINAL_ENABLED=false
LONGITUDINAL_MAX_PRIOR_STUDIES=5

# --- PET-CT AI-authored report findings ---
# Set PETCT_AI_REPORT_ENABLED=true to have Gemini Vision read the MIP + fused PET/CT
# images together with the computed lesion list and write the SCAN FINDINGS/CONCLUSIONS
# sections of the pet_ct PDF report, acting as a radiologist correlating images with the
# quantitative detections rather than the deterministic per-region template.
# Stored in Result.summary["ai_report"] (generated once during the pipeline, reused on every
# PDF download). Falls back to the deterministic template on failure, disable, or missing key.
# Requires GEMINI_API_KEY above (a vision-capable model, e.g. gemini-2.5-flash).
PETCT_AI_REPORT_ENABLED=false

# --- MedGemma 1.5 4B via Ollama (local PET/CT vision-language findings) ---
# Set MEDGEMMA_ENABLED=true to have a LOCALLY-hosted MedGemma model read the numbered
# coronal lesion roadmap + composite regional crops together with the deterministic
# data-matrix (SUVmax / dimensions / TotalSegmentator locations) and write narrative
# FINDINGS/IMPRESSION into Result.summary["medgemma_findings"]. Runs on-prem via Ollama
# (`ollama pull medgemma`), so no PHI leaves the host — it does NOT replace the Gemini
# path and is fully non-blocking (any failure keeps the deterministic summary).
# When MEDGEMMA_ENABLED=true, the pet_ct AI report is authored by MedGemma instead
# of Gemini and stored in the SAME Result.summary["ai_report"] the UI/PDF render
# (so it "just shows up" — no UI change). MEDGEMMA_ENABLED takes precedence over
# PETCT_AI_REPORT_ENABLED for pet_ct.
MEDGEMMA_ENABLED=false
# OLLAMA_BASE_URL: the containerised worker defaults to http://host.docker.internal:11434
# (103.93.216.37 inside a container is NOT the host). Only set this if Ollama runs
# elsewhere. The Ollama daemon must listen on 0.0.0.0 (OLLAMA_HOST=0.0.0.0:11434)
# for the container to connect.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Must be an `ollama pull`ed tag. This host currently has: medgemma1.5:latest, medgemma:27b.
MEDGEMMA_MODEL=medgemma1.5:latest
MEDGEMMA_MAX_IMAGES=6
MEDGEMMA_TIMEOUT_S=300

# --- HuggingFace token ---
# Used to download the SAM-Med3D checkpoint (backend/external/SAM-Med3D-main/ckpt/) for
# the abdomen_ct tumour-measurement step. That repo is public so a token isn't strictly
# required, and it's not needed once the checkpoint is cached on disk. Create one at
# https://huggingface.co/settings/tokens.
HF_TOKEN=

# --- Mammography structured findings (Mammo-CLIP) ---
# Set MAMMOGRAPHY_CLIP_ENABLED=true to run the Mammo-CLIP B5 zero-shot classifier for
# breast density (a-d) and mass/calcification presence, filling the structured per-breast
# finding slots. Stage weights via `python scripts/download_mammo_clip.py` (into the path below).
# The narrative prose for these slots reuses LLM_ENABLED / GEMINI_API_KEY above.
# WARNING: Mammo-CLIP is CC BY-NC-SA (non-commercial). Do NOT enable in a commercial
# deployment without swapping to a commercially-licensed model (e.g. ianpan/mammoscreen, Apache-2.0).
MAMMOGRAPHY_CLIP_ENABLED=false
MAMMOGRAPHY_CLIP_WEIGHTS_PATH=/model_cache/mammo_clip
# Lesion localization detector (quadrant/margins) — deferred, needs VinDr-Mammo fine-tuning.
MAMMOGRAPHY_DETECTOR_ENABLED=false
MAMMOGRAPHY_DETECTOR_WEIGHTS_PATH=/model_cache/mammo_detector
# Fine-tuned Mammo-CLIP B5 multi-label classifier (VinDr-trained): fills ALL SEVEN structured
# per-breast slots (mass, calcification, architectural distortion, skin thickening, nipple
# retraction, axillary node, density a-d) with trained probabilities — supersedes the zero-shot
# slots. Also needs the released B5 checkpoint at MAMMOGRAPHY_CLIP_WEIGHTS_PATH (to rebuild the
# backbone). Stage best_all.pt from backend/scripts/mammo_finetune/. CC BY-NC-SA (non-commercial).
MAMMOGRAPHY_FINETUNED_ENABLED=false
MAMMOGRAPHY_FINETUNED_WEIGHTS_PATH=/model_cache/mammo_clip_finetuned/best_all.pt
# Set MAMMOGRAPHY_AI_REPORT_ENABLED=true to have Gemini Vision read the rendered views + the
# model's per-breast finding probabilities and author the per-breast findings / opinion / BI-RADS
# as a radiologist would (AECH-KIRAN layout). Requires GEMINI_API_KEY. Falls back to the
# deterministic slot-rephrasing narrative when disabled or on failure.
MAMMOGRAPHY_AI_REPORT_ENABLED=false

# --- DICOM SR / Seg Export (Phase 7) ---
# Set DICOM_SR_ENABLED=true to export AI measurements as a DICOM Structured Report to Orthanc
# after every completed pipeline run. The SR encodes all measurements, QA flags, and LLM
# clinical context as TID 2000 Basic Text SR content items.
# Set DICOM_SEG_ENABLED=true to additionally export the segmentation NIfTI as a DICOM
# Segmentation Image object. Requires highdicom (already in main dependencies).
# Both objects appear in Orthanc/OHIF under the same Study as a new SR/SEG series.
DICOM_SR_ENABLED=false
DICOM_SEG_ENABLED=false

# --- In-app DICOM upload ---
# Lets authenticated users push DICOM files/folders from the browser via
# POST /api/studies/upload (the /upload page's "Upload from this computer" panel),
# which stores them in Orthanc and ingests every study — replacing the open Orthanc
# Explorer for browser uploads. Set to false to disable the endpoint (returns 403).
DICOM_UPLOAD_ENABLED=true

# Lets authenticated users permanently delete a study from Orthanc PACS via
# DELETE /api/orthanc/studies/{orthanc_id} (the /upload page's bulk-select "Delete"
# action). Irreversible — the DICOM data is gone unless the scanner resends it. Set
# to false to disable the endpoint (returns 403).
ORTHANC_DELETE_ENABLED=true

# --- FHIR export (F11) ---
# Set FHIR_ENABLED=true to expose GET /api/reports/{study_uid}/{usecase}/fhir, which
# renders an AI result as a FHIR R4 DiagnosticReport and POSTs it to FHIR_SERVER_URL
# when one is configured (with no URL it only returns the payload).
#
# LEAVE THIS FALSE. The export is not yet R4-conformant — see
# FHIR_R4_COMPLIANCE_AUDIT.md. Currently emitted: a DiagnosticReport whose status is
# derived from studies.reading_status (unread/in_progress/reported -> preliminary,
# signed -> final, superseded -> entered-in-error), with narrative conclusion only.
# NOT yet emitted, and required before enabling for real clinical use:
#   - subject: needs Patient?identifier={system}|{mrn} resolution (never Patient/{mrn})
#   - Observation: needs a per-plugin LOINC/UCUM whitelist (fhir_map.yaml)
#   - timezone-qualified timestamps on studies.study_date (DICOM StudyTime is dropped)
FHIR_ENABLED=false
FHIR_SERVER_URL=
# Identifier.system URIs — the namespaces that issued the identifiers this deployment
# holds. A FHIR Identifier without a system is not matchable: "12345" says nothing about
# which numbering scheme issued it, and across tenants two hospitals' MRN "12345" become
# indistinguishable. Only you know your own namespaces, so there is no sensible default.
# Left empty, the identifier is OMITTED from FHIR output rather than emitted unqualified
# (an unqualified identifier invites a false match on the receiving system).
# Ask the receiving site for these values — they are theirs to define, not yours to guess.
#   PATIENT    namespace of studies.patient_id      (DICOM PatientID / MRN)
#   ACCESSION  namespace of studies.accession_number
#   ORDER      namespace of orders.external_order_ref (RIS/EHR order number)
# e.g. https://hospital.example.org/fhir/sid/mrn
FHIR_PATIENT_IDENTIFIER_SYSTEM=
FHIR_ACCESSION_IDENTIFIER_SYSTEM=
FHIR_ORDER_IDENTIFIER_SYSTEM=

# --- HL7 v2 messaging (F21) ---
# Set HL7_ENABLED=true to run the standalone MLLP listener (app.hl7_listener) that
# receives ADT (patient demographics) and ORM/OMG (imaging orders) from the RIS/EHR
# and populates the patients/orders tables. Patients stay de-identified: inbound
# name/DOB are NEVER persisted — DOB is converted to an age band at ingest.
# NB: HL7_MLLP_PORT defaults to 2576 because the DICOM worklist SCP already uses 2575.
HL7_ENABLED=false
HL7_MLLP_HOST=0.0.0.0
HL7_MLLP_PORT=2576
HL7_SENDING_APPLICATION=MRCV
HL7_SENDING_FACILITY=MRCV_AI
HL7_ACCEPT_VERSION=2.5.1
HL7_DEFAULT_TENANT=default
# Persist raw message text (contains PHI). Leave false unless a retention policy allows it;
# by default only a sha256 hash + de-identified parsed fields are stored.
HL7_STORE_RAW_MESSAGES=false
# Outbound ORU (AI results → RIS/EHR), sent from the post-result Celery hook.
HL7_OUTBOUND_ENABLED=false
HL7_OUTBOUND_HOST=
HL7_OUTBOUND_PORT=0
HL7_OUTBOUND_TIMEOUT_S=30
HL7_OUTBOUND_MAX_RETRIES=3

# --- Security (Phase 0) ---
# Master key for token signing, MFA-secret encryption and the audit hash chain.
# Generate: python -c "import secrets;print(secrets.token_hex(32))". Rotate ONLY with
# backend/scripts/rotate_master_key.py (it re-encrypts MFA secrets and records the cut-over).
JWT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS
AUDIT_CHAIN_PREVIOUS_MASTER_KEY=
AUDIT_CHAIN_ROTATED_AFTER_SEQ=0
PHI_HASH_SALT=REPLACE_WITH_RANDOM
REDIS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
# Refuse to start on default secrets / insecure auth modes. Keep true outside local dev.
ENFORCE_SECURE_CONFIG=true
# Interactive API docs (/docs, /redoc, /openapi.json). Off in deployments.
API_DOCS_ENABLED=false

# --- Sessions, emergency access, outbound, retention (Phase 1 / Phase 4) ---
# Access tokens are short-lived; sessions continue via a rotating httpOnly refresh cookie.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Automatic logoff: idle limit (server-enforced; the UI warns 2 minutes before) and the
# absolute session lifetime.
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12
# Roles that must use MFA (forced enrolment at next sign-in), plus platform accounts.
MFA_REQUIRED_ROLES=admin,radiologist
MFA_REQUIRED_FOR_PLATFORM=true
# Login lockout / throttling. On Docker Desktop (Windows) client IPs are hidden, so the
# per-IP limit is effectively global there; use ~20 on Linux where real IPs are preserved.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_ATTEMPTS_PER_MINUTE=20
PASSWORD_MIN_LENGTH=12
# Break-glass emergency access: grant duration and minimum reason length.
BREAK_GLASS_MINUTES=60
BREAK_GLASS_MIN_REASON_CHARS=20
# Webhooks / FHIR must be https:// (true only for local development).
ALLOW_INSECURE_OUTBOUND=false
# Send the patient MRN in webhook payloads only to receivers covered by a BAA.
WEBHOOK_INCLUDE_PATIENT_ID=false
# Retention: purges run only when enabled; never purge clinical data younger than
# RETENTION_MIN_DAYS (set to your jurisdiction's medical-record retention period).
RETENTION_ENABLED=false
RETENTION_MIN_DAYS=0
# /api/debug/medgemma/* (raw model prompts/outputs) — development only.
DEBUG_ROUTES_ENABLED=false

# --- Destinations, sessions, audit review (HIPAA batch 3) ---
# External AI (Gemini) receives PHI. With PRODUCTION_MODE=true it is used only once a BAA
# covers the provider and this is set; otherwise every Gemini feature stays off.
EXTERNAL_AI_BAA_CONFIRMED=false
# Webhook / FHIR destinations allowed to receive PHI (the BAA register): comma-separated
# hosts, ".example.org" for subdomains. Empty = any https host, except in production mode,
# where empty means none.
OUTBOUND_ALLOWED_HOSTS=
# The browser session token is an httpOnly cookie (mrv_access). false = it is no longer
# returned in JSON at all (production); API clients then use API keys.
ACCESS_TOKEN_IN_BODY=true
# Monthly audit-log review (Beat, 1st of the month): local time zone and business hours
# used to flag after-hours reads of patient data.
AUDIT_REVIEW_ENABLED=true
AUDIT_REVIEW_TIMEZONE=UTC
AUDIT_REVIEW_BUSINESS_HOURS=07-19

# --- Compliance controls (HIPAA batch 4, migrations 056-057) ---
# Audit review every month (1st) or every week (Mondays).
AUDIT_REVIEW_CADENCE=monthly
# Monthly HMAC-signed audit-log archive into the WORM bucket minio/init.sh creates
# (Object Lock, compliance mode, AUDIT_ARCHIVE_RETENTION_DAYS). Production: true.
AUDIT_ARCHIVE_ENABLED=false
AUDIT_ARCHIVE_BUCKET=audit-archive
AUDIT_ARCHIVE_RETENTION_DAYS=2190
# Security alert rules over the audit log every 10 minutes (lockouts, failed sign-in
# bursts of SECURITY_ALERT_FAILED_LOGINS from one address, break-glass, token reuse,
# integrity failures) -> admins in real time, security_alert webhooks, structured log.
SECURITY_ALERTS_ENABLED=true
SECURITY_ALERT_FAILED_LOGINS=10
# AI results leave the platform (SR/SEG, FHIR, webhook findings) only once signed.
REQUIRE_SIGNED_FOR_EXPORT=true
# No PHI before a BAA: tenants need an active BAA record to be activated or to receive AE
# titles / API keys. Production: true.
REQUIRE_TENANT_BAA=false
# Pipelines get Safe Harbor de-identified copies; burned-in text is OCR-masked first.
PHI_DEIDENTIFY_ENABLED=false
BURNED_IN_TEXT_CHECK_ENABLED=true
# US: signing (and SR export) requires a valid NPI on the radiologist's practitioner record.
REQUIRE_NPI_FOR_SIGNING=false
# Viewer gets only the DICOM attributes it displays (study/series allowlist, demographics
# removed from metadata and files). Production: true.
VIEWER_MINIMUM_NECESSARY=false
# A/B experiments as isolated shadow jobs (needs the worker-shadow service:
# MRCV_COMPOSE_PROFILES=shadow).
AB_SHADOW_ENABLED=false
# Optional SIEM log shipping (MRCV_COMPOSE_PROFILES=siem, ops/siem/vector.toml).
# SIEM_HTTP_URL=https://siem.example.org/ingest
# SIEM_HTTP_TOKEN=

# --- Production stack (docker-compose.prod.yml sets these; listed for reference) ---
# PRODUCTION_MODE=true makes the startup guard also require every item below.
# PRODUCTION_MODE=true
# DB_SSL_MODE=verify-full            DB_SSL_ROOT_CERT=/run/pki/ca.crt
# REDIS_TLS=true                     REDIS_CA_CERT=/run/pki/ca.crt   (Celery: rediss://)
# MINIO_SECURE=true                  MINIO_CA_CERT=/run/pki/ca.crt
# ORTHANC_SCHEME=https               ORTHANC_CA_CERT=/run/pki/ca.crt
# MINIO_KMS_CONFIGURED=true          ORTHANC_STORAGE_ENCRYPTED=true
# Deployment: ops/deploy/README.md (secrets via SOPS: ops/deploy/secrets-init.sh).
