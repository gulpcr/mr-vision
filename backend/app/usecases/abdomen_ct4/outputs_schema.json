{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Abdomen CT (v4) Two-Stage Multi-Agent Report Result",
  "type": "object",
  "required": ["summary", "measurements", "qa_flags", "model_version", "artifacts"],
  "properties": {
    "summary": {
      "type": "object",
      "properties": {
        "modality": { "type": ["string", "null"] },
        "series_description": { "type": ["string", "null"] },
        "study_description": { "type": ["string", "null"] },
        "candidate_slices": { "type": "integer" },
        "image_dimensions": { "type": "array", "items": { "type": "integer" } },
        "hu_window": {
          "type": "object",
          "properties": {
            "level": { "type": "number" },
            "width": { "type": "number" }
          }
        },
        "quantitative": { "type": "boolean" },
        "slice_selection": { "type": "string" },
        "inference_method": { "type": "string" },
        "processing_notes": { "type": "string" },
        "normal": { "type": ["boolean", "null"] },
        "num_batches": { "type": ["integer", "null"] },
        "pathology_zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_z": { "type": "integer" },
              "end_z": { "type": "integer" },
              "start_index": { "type": "integer" },
              "end_index": { "type": "integer" },
              "reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "malformed_batches": { "type": ["integer", "null"] },
        "final_report": { "type": ["string", "null"] },
        "ai_report_provider": { "type": "string" }
      }
    },
    "measurements": {
      "type": "object",
      "properties": {
        "image_dimensions": { "type": "array", "items": { "type": "integer" } },
        "candidate_slices": { "type": "integer" },
        "scan_images_rendered": { "type": "integer" }
      }
    },
    "qa_flags": { "type": "array", "items": { "type": "string" } },
    "qa_details": { "type": "object", "additionalProperties": true },
    "model_version": { "type": "string" },
    "model_checksum": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "artifact_type", "local_path"],
        "properties": {
          "name": { "type": "string" },
          "artifact_type": { "type": "string" },
          "local_path": { "type": "string" },
          "content_type": { "type": "string" }
        }
      }
    }
  }
}
