# Files executed or parsed on the Linux host / in containers must keep LF line endings,
# whatever core.autocrlf is set to on a Windows checkout.
*.sh            text eol=lf
*.lua           text eol=lf
*.template      text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.env.example   text eol=lf
nginx/**        text eol=lf
postgres/**     text eol=lf
orthanc/*.json  text eol=lf
