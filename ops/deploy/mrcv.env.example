# /etc/mrcv/mrcv.env — the NON-secret production settings (mode 0600, root).
#
# ops/deploy/up.sh joins this file with the decrypted SOPS secrets
# (/etc/mrcv/secrets.enc.env, ops/deploy/secrets-init.sh) into /run/mrcv/.env on tmpfs.
# Never put a password, key or token here — `sops /etc/mrcv/secrets.enc.env` edits the
# secrets. Every application setting from the repository's .env.example may be set here;
# the TLS / encryption settings are fixed by docker-compose.prod.yml and need no entry.

# ── Site ──────────────────────────────────────────────────────────────────────
PUBLIC_DOMAIN=pacs.example-hospital.org
CERTBOT_EMAIL=it-security@example-hospital.org
# Extra compose files, comma-separated, relative to the checkout (provider overlays), e.g.
#   ops/providers/gcp/docker-compose.gcp.yml
MRCV_COMPOSE_OVERLAYS=
# Optional compose profiles, comma-separated: "shadow" = isolated worker for A/B shadow
# runs (also set AB_SHADOW_ENABLED=true).
MRCV_COMPOSE_PROFILES=
MRCV_PKI_DIR=/srv/mrcv/pki

# ── Public certificate ────────────────────────────────────────────────────────
# Empty = Let's Encrypt (DNS must point here, port 80 reachable). Your own certificate:
# copy fullchain.pem + privkey.pem into TLS_BYO_DIR and set (container paths):
#   TLS_CERT_FILE=/etc/nginx/byo/fullchain.pem
#   TLS_KEY_FILE=/etc/nginx/byo/privkey.pem
TLS_BYO_DIR=/srv/mrcv/tls
TLS_CERT_FILE=
TLS_KEY_FILE=
# Behind a load balancer / reverse proxy: its address range(s), comma-separated, so the
# real client IP is used for audit entries and login limits. Empty = clients connect directly.
TRUSTED_PROXY_CIDRS=

# ── Scanner DICOM (ops/deploy/SCANNERS.md) ────────────────────────────────────
# Mutual-TLS DICOM on DICOM_PORT. Without TLS-capable scanners: DICOM_TLS_ENABLED=false,
# DICOM_PORT=4242 and DICOM_BIND=<WireGuard address, e.g. 10.66.0.1> (ops/vpn/wireguard).
DICOM_PORT=2762
DICOM_TLS_ENABLED=true
DICOM_BIND=0.0.0.0
# Networks scanners connect from (DOCKER-USER firewall, ops/deploy/docker-firewall.sh).
SCANNER_CIDRS=
# {"ct1": ["CT_SCANNER_AET", "10.20.0.5", 104]}
ORTHANC_DICOM_MODALITIES={}

# ── Database roles (passwords are in the secrets) ─────────────────────────────
POSTGRES_DB=mri_platform
POSTGRES_USER=mri_admin
POSTGRES_APP_USER=mrv_app
AUTH_MODE=jwt

# ── External services that receive PHI (BAA register) ─────────────────────────
# Gemini stays OFF in production until a BAA covers the provider. Then set:
EXTERNAL_AI_BAA_CONFIRMED=false
GEMINI_BACKEND=api_key
# Webhook / FHIR destinations allowed to receive PHI (host, or .domain for subdomains).
OUTBOUND_ALLOWED_HOSTS=

# ── Backups (ops/backup.sh) ───────────────────────────────────────────────────
# PUBLIC age key of the OFFLINE backup key pair (ops/KEYS.md); this host cannot decrypt.
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=offsite
BACKUP_PATH=mrcv-backups/site1
BACKUP_RETENTION_DAYS=35
# Destination, any rclone backend. Non-secret parts here, credentials in the secrets
# (RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID / _SECRET_ACCESS_KEY / _ACCOUNT / _KEY ...). E.g.:
#   S3 / Wasabi / B2-S3:  TYPE=s3  PROVIDER=AWS  REGION=eu-west-1
#   Azure Blob:          TYPE=azureblob  (ACCOUNT + KEY in the secrets)
#   Google Cloud:        TYPE=gcs  (SERVICE_ACCOUNT_CREDENTIALS in the secrets)
#   SFTP:                TYPE=sftp  HOST=backup.example.org  USER=mrcv
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
RCLONE_CONFIG_OFFSITE_REGION=eu-west-1
# Server-side encryption at the destination as well (defence in depth; data is already
# client-side encrypted).
RCLONE_CONFIG_OFFSITE_SERVER_SIDE_ENCRYPTION=AES256

# ── Audit review / retention ──────────────────────────────────────────────────
# The site's local time zone (after-hours reads are flagged in the monthly review).
AUDIT_REVIEW_TIMEZONE=UTC
AUDIT_REVIEW_BUSINESS_HOURS=07-19
RETENTION_ENABLED=false
RETENTION_MIN_DAYS=0

# ── AI features (local MedGemma via the ollama service) ───────────────────────
MEDGEMMA_ENABLED=true
# Pin the image you validated (docker compose exec ollama ollama --version).
# OLLAMA_IMAGE=ollama/ollama:<tag>
