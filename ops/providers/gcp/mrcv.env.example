# /etc/mrcv/mrcv.env — NON-SECRET production settings for the GCP VM (mode 0644 is fine).
# ops/providers/gcp/render-env.sh concatenates this with the secrets from Secret Manager into
# /opt/mrcv/.env at boot. Do NOT put passwords/keys here: render-env refuses to run if a
# secret name (POSTGRES_PASSWORD, JWT_SECRET_KEY, ...) appears in this file.
# Any other setting from the repo's .env.example may be added below.

# --- Deployment identity ---
PUBLIC_DOMAIN=mrcv.example.org
CERTBOT_EMAIL=ops@example.org
# Set to 1 for a first dry run against the Let's Encrypt staging CA.
CERTBOT_STAGING=0
GCP_PROJECT=your-project-id
GCP_LOCATION=us-central1

# --- Security posture (the gcp compose override also forces most of these) ---
ENFORCE_SECURE_CONFIG=true
API_DOCS_ENABLED=false
VIEWER_COOKIE_SECURE=true
ALLOWED_ORIGINS=https://mrcv.example.org
AUTH_MODE=jwt
REQUIRE_RLS=true
LOGIN_IP_ATTEMPTS_PER_MINUTE=20
PUBLIC_REGISTRATION_ENABLED=false

# --- Service accounts / names (passwords come from Secret Manager) ---
POSTGRES_DB=mri_platform
POSTGRES_USER=mri_admin
POSTGRES_APP_USER=mrv_app
MINIO_ACCESS_KEY=mri_minio_admin
MINIO_BUCKET=mri-artifacts
ORTHANC_USERNAME=orthanc
# Scanners allowed to C-STORE (Orthanc DicomModalities JSON). May instead be stored as
# the optional secret mrcv-ORTHANC_DICOM_MODALITIES.
ORTHANC_DICOM_MODALITIES={}
DICOM_UNMAPPED_AET_TENANT=default

# --- Gemini: Vertex AI only (BAA-covered). Never set GEMINI_API_KEY in production. ---
GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-2.5-flash

# --- MedGemma via the ollama container ---
OLLAMA_BASE_URL=http://ollama:11434
MEDGEMMA_MODEL=medgemma1.5:latest

# --- Feature flags: copy the values you run today from the old host's .env ---
LLM_ENABLED=false
VLM_QA_ENABLED=false
CDS_ENABLED=false
LONGITUDINAL_ENABLED=false
PETCT_AI_REPORT_ENABLED=false
MEDGEMMA_ENABLED=false
MAMMOGRAPHY_AI_REPORT_ENABLED=false
DICOM_SR_ENABLED=false
DICOM_SEG_ENABLED=false
MULTI_TENANT_ENABLED=false
